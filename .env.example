# ---------------------------------------------------------------------------
# Seonet environment template
# Copy to .env and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL / PostGIS)
DATABASE_URL=postgres://seonet:seonet@localhost:5432/seonet

# Cache / broker
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://seonet:seonet@localhost:5672/seonet

# Celery
CELERY_BROKER_URL=amqp://seonet:seonet@localhost:5672/seonet
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie / auth
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# Email (console backend in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Seonet <noreply@localhost>

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# AI providers (server-side only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Maps / lead sources
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CSE_ID=
SERPAPI_API_KEY=
YELP_API_KEY=
FOURSQUARE_API_KEY=
GEOAPIFY_API_KEY=
OPENCORPORATES_API_TOKEN=
NOMINATIM_CONTACT_EMAIL=
LINKEDIN_ACCESS_TOKEN=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
APOLLO_API_KEY=

# CRM
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ODOO_URL=
ODOO_DATABASE=
ODOO_CLIENT_ID=
ODOO_CLIENT_SECRET=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags
AI_AEO_ENABLED=false
LEAD_DISCOVERY_ENABLED=false
HUBSPOT_ENABLED=false
ODOO_ENABLED=false
WHITE_LABEL_ENABLED=false
